# Database Configuration
# Local development uses the SQLite provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rajagro_db?schema=public"

# Admin Authentication Secret - replace with a long random value before deployment.
# Required. Both src/lib/auth.ts and middleware.ts read this; there is no
# fallback, so admin login fails closed if it is missing.
JWT_SECRET="[REPLACE_WITH_LONG_RANDOM_SECRET]"

# Password for the admin account created by `prisma/seed.ts`. Required to seed;
# minimum 12 characters. Change it after the first login.
ADMIN_SEED_PASSWORD="[REPLACE_WITH_STRONG_PASSWORD]"

# Business Information Defaults (Overrides config/site.ts if provided)
NEXT_PUBLIC_BUSINESS_NAME="M/s Raj Agro Engineering Works"
NEXT_PUBLIC_BUSINESS_PHONE="+91 7651861335"
NEXT_PUBLIC_BUSINESS_WHATSAPP="917651861335"
NEXT_PUBLIC_BUSINESS_EMAIL="info@raew.in"
NEXT_PUBLIC_BUSINESS_ADDRESS="Madawa Newada, Post- Rehi, Mirzapur, Uttar Pradesh, India - 231211"
NEXT_PUBLIC_BUSINESS_GSTIN="09BAZPT1519D1Z8"
NEXT_PUBLIC_BUSINESS_HOURS="24/7"
NEXT_PUBLIC_SITE_URL="https://raew.in"

# Optional Email / Notification Service
# Not consumed by any code yet: enquiries, applications and messages are stored
# in the database and are read in the admin panel. Add an SMTP or Resend
# transport in src/lib/ and read these values there when you want outbound mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
ADMIN_EMAIL=""

# Optional object storage for product photographs and brochures.
# Not consumed by any code yet: images are referenced by URL or by a path under
# /public, and are set from the admin panel. Fill these in and use them in
# src/lib/ if you move uploads to Cloudinary, S3 or an S3-compatible bucket.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

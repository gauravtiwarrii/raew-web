# Database Configuration
# Local development uses the SQLite provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rajagro_db?schema=public"

# Admin Authentication Secret - replace with a long random value before deployment.
JWT_SECRET="[REPLACE_WITH_LONG_RANDOM_SECRET]"

# Business Information Defaults (Overrides config/site.ts if provided)
NEXT_PUBLIC_BUSINESS_NAME="M/s Raj Agro Engineering Works"
NEXT_PUBLIC_BUSINESS_PHONE="[REPLACE WITH ACTUAL BUSINESS PHONE]"
NEXT_PUBLIC_BUSINESS_WHATSAPP="[REPLACE WITH ACTUAL WHATSAPP NUMBER]"
NEXT_PUBLIC_BUSINESS_EMAIL="[REPLACE WITH BUSINESS EMAIL]"
NEXT_PUBLIC_BUSINESS_ADDRESS="[REPLACE WITH FACTORY ADDRESS]"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Email / Notification Service
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
